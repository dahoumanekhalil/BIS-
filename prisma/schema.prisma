generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Event {
  id                String   @id @default(cuid())
  slug              String   @unique
  name              String
  tagline           String?
  description       String?
  startsAt          DateTime
  endsAt            DateTime
  city              String
  venue             String
  country           String
  expectedAttendees Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  sessions     Session[]
  speakers     Speaker[]
  partners     Partner[]
  spaces       Space[]
  participants Participant[]
  applications Application[]
}

enum SessionType {
  KEYNOTE
  TALK
  PANEL
  FIRESIDE
  WORKSHOP
  MASTERCLASS
  MASTERMIND
  PITCH
  SHOWCASE
}

enum SessionCategory {
  INNOVATION
  ENTREPRENEURSHIP
  TECHNOLOGY
  IMPACT
  CULTURE
  INVESTMENT
  LEADERSHIP
}

model Session {
  id            String           @id @default(cuid())
  eventId       String
  event         Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  slug          String           @unique
  title         String
  summary       String?          @db.Text
  type          SessionType      @default(KEYNOTE)
  category      SessionCategory  @default(INNOVATION)
  startsAt      DateTime
  durationMin   Int              @default(45)
  stage         String?
  isHighlighted Boolean          @default(false)
  order         Int              @default(0)
  speakers      SessionSpeaker[]
  spaceId       String?
  space         Space?           @relation(fields: [spaceId], references: [id])
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([eventId, startsAt])
}

model Speaker {
  id            String           @id @default(cuid())
  eventId       String
  event         Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  slug          String           @unique
  fullName      String
  title         String
  organization  String
  country       String?
  bio           String?          @db.Text
  photoUrl      String?
  linkedin      String?
  twitter       String?
  website       String?
  isHighlighted Boolean          @default(false)
  order         Int              @default(0)
  adminUserId   String?          @unique
  adminUser     AdminUser?       @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  sessions      SessionSpeaker[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([eventId])
}

model SessionSpeaker {
  sessionId String
  speakerId String
  role      String  @default("SPEAKER")
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  speaker   Speaker @relation(fields: [speakerId], references: [id], onDelete: Cascade)

  @@id([sessionId, speakerId])
}

enum PartnerTier {
  PRESENTING
  PLATINUM
  GOLD
  SILVER
  ECOSYSTEM
  MEDIA
}

model Partner {
  id        String      @id @default(cuid())
  eventId   String
  event     Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  slug      String      @unique
  name      String
  tier      PartnerTier @default(ECOSYSTEM)
  logoUrl   String?
  website   String?
  order     Int         @default(0)
  createdAt DateTime    @default(now())

  @@index([eventId, tier])
}

model Space {
  id          String    @id @default(cuid())
  eventId     String
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  slug        String    @unique
  name        String
  headline    String
  description String    @db.Text
  color       String    @default("#1748E6")
  icon        String?
  imageUrl    String?
  order       Int       @default(0)
  sessions    Session[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum RegistrationType {
  ATTENDEE
  STARTUP
  INVESTOR
  MEDIA
  PARTNER
}

// Additive migration to introduce REGISTERED alongside the legacy PENDING.
//   REGISTERED  — the person successfully completed event registration.
//                 Default for every new Participant.
//   CONFIRMED   — the person is confirmed to attend (admin transition).
//   CANCELLED   — event registration was cancelled.
//   PENDING     — DEPRECATED. Retained only for backward compatibility of
//                 rows created before the migration; new code must never
//                 write this value. Retired in a follow-up commit once
//                 the data-migration script has swept it to REGISTERED.
enum RegistrationStatus {
  PENDING
  REGISTERED
  CONFIRMED
  CANCELLED
}

enum RegistrationTier {
  VVIP
  VIP
  VISITOR
  CONTENT_CREATOR
  IMPACT_MAKER
}

// Distinguishes a personal visitor registration from a company/organization
// registration. Purely informational — it does not change RegistrationType
// semantics or downstream ops logic.
enum RegistrationProfile {
  VISITOR
  COMPANY
}

// The user's chosen way to participate in BIS 2027 — captured at Step 2 of
// the unified /register journey. Distinct from `RegistrationType` (which
// remains ATTENDEE|STARTUP|INVESTOR|MEDIA|PARTNER for existing ops logic).
// NULL means the user has not yet completed Step 2.
enum ParticipationChoice {
  VISITOR
  SPONSOR
  PARTNER
  SPEAKER
  CONTENT_CREATOR
}

model Participant {
  id               String             @id @default(cuid())
  eventId          String
  event            Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  firstName        String
  lastName         String
  email            String
  // Nullable — the account-signup flow bootstraps a Participant without a
  // phone number. It's collected at Step 3 of the /register wizard.
  phone            String?
  organization     String?
  jobTitle         String?
  country          String             @default("Algérie")
  registrationType RegistrationType   @default(ATTENDEE)
  status           RegistrationStatus @default(REGISTERED)

  // Optional link back to the AccountUser (public login system). Populated
  // when a Participant is bootstrapped from an authenticated account signup.
  accountUserId String?
  accountUser   AccountUser? @relation(fields: [accountUserId], references: [id], onDelete: SetNull)

  // Company registration additions — nullable/defaulted, additive only.
  profile         RegistrationProfile @default(VISITOR)
  companyIndustry String?
  companyWebsite  String?
  companySize     String?

  // Chosen participation type (Step 2 of the unified journey). NULL while
  // onboarding is still in progress or if the user abandoned before Step 2.
  participationChoice ParticipationChoice?

  onboardingSessions OnboardingSession[]
  applications       Application[]

  // Badge / access — see the ACCESS & BADGES section below.
  credentials       BadgeCredential[]
  accessPermissions ParticipantAccess[]
  roomRegistrations RoomRegistration[]

  // Ops fields (admin platform)
  tier          RegistrationTier?
  gate          String?
  ticketCode    String?           @unique
  // Phase 19 — secure human-readable text check-in code (fallback
  // input when QR scanning is impractical). Format: XXXX-XXXX-XXXX
  // (12 payload chars + 2 dashes, 14 chars total) from a 28-char
  // unambiguous charset (no O/0/I/1/S/5/B/8). Cryptographically
  // random. Server-normalized on validation. `ticketCode` remains
  // the legacy admin-typed identifier for the /admin/check-in flow;
  // this is a SEPARATE credential surface designed specifically for
  // manual text input at the QR scanner. Nullable so existing rows
  // can be backfilled by scripts/backfill-checkin-codes.mjs.
  checkinCode   String?           @unique @db.VarChar(16)
  checkedInAt   DateTime?
  checkedInGate String?

  checkIns CheckIn[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, email])
  @@index([eventId, createdAt])
  @@index([tier])
  @@index([status])
  @@index([profile])
  @@index([participationChoice])
  @@index([accountUserId])
}

// Short-lived server-side state carrier for the multi-step /register wizard.
// After Step 1 (basic registration) we create a Participant and this session
// pointing at it. The cookie holds an opaque token — the DB stores tokenHash.
// Steps 2+ read the cookie and resolve back to the Participant.
model OnboardingSession {
  id            String      @id @default(cuid())
  tokenHash     String      @unique
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  expiresAt     DateTime

  @@index([expiresAt])
  @@index([participantId])
}

// --------------------------- BE A PART / APPLICATIONS ---------------------------

enum ApplicationType {
  SPONSOR
  PARTNER
  SPEAKER
  CONTENT_CREATOR
}

enum ApplicationStatus {
  RECEIVED
  UNDER_REVIEW
  CONTACTED
  APPROVED
  REJECTED
}

// Represents a "Be a part" application. Kept intentionally separate from
// Participant / Registration — application review status and registration
// status are different domains.
model Application {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Every Application built through the unified /register journey has a
  // Participant. Kept nullable so an admin-created / legacy row cannot break
  // the model. ondelete SetNull: preserves history if a Participant is purged.
  participantId String?
  participant   Participant? @relation(fields: [participantId], references: [id], onDelete: SetNull)

  type   ApplicationType
  status ApplicationStatus @default(RECEIVED)

  // Contact person (all types)
  firstName String
  lastName  String
  email     String
  phone     String
  country   String  @default("Algérie")
  position  String?

  // Organization info (SPONSOR / PARTNER always; SPEAKER / CONTENT_CREATOR optional)
  organization String?
  website      String?
  industry     String?

  // Speaker / Content Creator optional media (URLs only — file storage TBD)
  photoUrl String?
  logoUrl  String?
  linkedin String?

  // Free-form message shown to the reviewer
  message String? @db.Text

  // Role-specific structured payload, validated per ApplicationType by Zod
  // at write time. Reader-side Zod schemas live in lib/applications.ts.
  details Json

  // Review fields — separate from RegistrationStatus.
  reviewNotes  String?   @db.Text
  reviewedById String?
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One application per (participant, role) — defensive uniqueness that also
  // closes the check-then-act race in submitParticipation.
  @@unique([participantId, type])
  @@index([eventId, type, status])
  @@index([status])
  @@index([type])
  @@index([email])
  @@index([createdAt])
  @@index([participantId])
}

model SiteContent {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// --------------------------- PUBLIC ATTENDEE ACCOUNTS ---------------------------
// Separate from AdminUser: no roles, no back-office access.

model AccountUser {
  id              String    @id @default(cuid())
  email           String    @unique
  firstName       String
  lastName        String
  passwordHash    String
  lastLoginAt     DateTime?
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions           AccountSession[]
  participants       Participant[]
  verificationTokens EmailVerificationToken[]
  passwordResets     PasswordResetToken[]
}

model AccountSession {
  id        String      @id @default(cuid())
  userId    String
  user      AccountUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String      @unique
  createdAt DateTime    @default(now())
  expiresAt DateTime

  @@index([userId])
  @@index([expiresAt])
}

// SMTP-linked authentication artefacts. Both tables mirror the AccountSession
// pattern: only sha256(tokenHash) is persisted so a database leak cannot be
// replayed as a working token. `usedAt` enforces single-use consumption at
// the application layer; expiry is compared against `expiresAt`.

model EmailVerificationToken {
  id           String      @id @default(cuid())
  userId       String
  user         AccountUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String      @unique
  // Snapshot of the email at issue-time. If the account changes email later,
  // the outstanding link no longer verifies the current email.
  emailAtIssue String
  createdAt    DateTime    @default(now())
  expiresAt    DateTime
  usedAt       DateTime?

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String      @id @default(cuid())
  userId    String
  user      AccountUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String      @unique
  createdAt DateTime    @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  // Best-effort audit metadata. Client IP is truncated at the caller
  // (see lib/account/password-reset.ts) before it lands here.
  requestIp String?

  @@index([userId])
  @@index([expiresAt])
}

// --------------------------- ACCESS & BADGES ---------------------------
// Physical venue access model. The BIS 2027 venue has one MAIN_ENTRANCE and
// five ROOMs; each is a distinct AccessPoint with its own operator team and
// scanner instance. A participant's per-room permissions live in
// ParticipantAccess. A participant's QR credential is a BadgeCredential.
// The QR itself is an opaque random token; only its sha256 is stored, so a
// database leak does not hand out working QR codes.

enum AccessPointType {
  MAIN_ENTRANCE
  ROOM
}

enum BadgeStatus {
  PENDING
  ACTIVE
  REVOKED
  EXPIRED
}

// Distinguishes the origin of a ParticipantAccess row so the room
// registration layer can safely materialize its own entitlements
// without stepping on legitimate admin overrides.
//
//   ADMIN         Row was created or last touched by a human admin via
//                 grantRoomAccessAction / revokeRoomAccessAction. This is
//                 the default for every pre-existing row (safe migration
//                 default) and for every future manual admin grant.
//                 syncRoomAccessEntitlement MUST NEVER mutate rows with
//                 source=ADMIN. Admin intent takes precedence.
//   REGISTRATION  Row is materialized by syncRoomAccessEntitlement from
//                 a RoomRegistration whose status is FREE_CONFIRMED. Only
//                 these rows may be updated/revoked by the sync service
//                 when the underlying registration transitions to
//                 CANCELLED.
//
// The room QR validator does NOT read this field — it still authorizes
// solely on `granted === true` (fast, deterministic). The source field
// is a boundary between the entitlement sync layer and the admin
// override layer.
enum AccessGrantSource {
  ADMIN
  REGISTRATION
}

// Registration/entitlement lifecycle for a participant attending a
// specific ROOM. Distinct from the physical CheckIn. All rooms are
// FREE — payment is not part of the model.
//
//   FREE_CONFIRMED    self-service registration succeeded.
//   CANCELLED         registration cancelled by attendee or admin.
//
// A registration returning to an active state after CANCELLED is
// allowed — a participant may re-register. The unique constraint on
// (participantId, accessPointId) forbids two rows for the same pair,
// so re-registration re-uses the existing row.
enum RoomRegistrationStatus {
  FREE_CONFIRMED
  CANCELLED
}

// AccessPoint is the operational identity of a physical space at the
// event. Phase 17 extends the record with optional descriptive +
// admission-policy fields and a Team membership relation, without
// touching the fields that are load-bearing for the existing scanner /
// validator / history pipelines (id / slug / name / type / active /
// order — all unchanged).
model AccessPoint {
  id        String          @id @default(cuid())
  slug      String          @unique
  name      String
  type      AccessPointType
  active    Boolean         @default(true)
  order     Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  // ── Descriptive fields (all nullable / defaulted, all additive) ──
  // Free-form paragraph describing what the space is for. Rendered by
  // /admin/spaces/[slug]; never surfaced to attendees today.
  description String? @db.Text
  // Lightweight content payloads. Each is a `Json` array of small
  // objects validated by Zod on write in the space actions module.
  // Deliberately NOT modelled as relational tables — this is a
  // configuration/CMS-lite surface, not a queryable domain model.
  //   activities: [{ title: string, description?: string }]
  //   topics:     [{ label: string }]
  //   exhibitors: [{ name: string, website?: string, description?: string }]
  activities  Json?
  topics      Json?
  exhibitors  Json?

  permissions       ParticipantAccess[]
  checkIns          CheckIn[]
  teamMembers       AccessPointTeamMember[]
  roomRegistrations RoomRegistration[]

  @@index([type])
  @@index([active])
}

// Phase 17 — dedicated Check-in team membership per space.
// This is a METADATA association only. The existing Phase 3/10/11
// scanner permission model is TYPE-LEVEL (`access.validate.main` +
// `access.validate.room`), so being on team X does NOT automatically
// authorise scanning X server-side today. Team membership is a
// staffing/coordination tool. Making it a per-space authorisation
// boundary is a documented deferral (see master doc §Phase 17).
model AccessPointTeamMember {
  accessPointId String
  adminUserId   String
  assignedAt    DateTime @default(now())
  assignedById  String?

  accessPoint AccessPoint @relation(fields: [accessPointId], references: [id], onDelete: Cascade)
  adminUser   AdminUser   @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@id([accessPointId, adminUserId])
  @@index([adminUserId])
  @@index([accessPointId])
}

// A BadgeCredential is a QR credential issued to a Participant. The raw
// token is generated once at issuance, encoded into the QR, and never stored
// server-side — only its sha256 hash is persisted. Rotation preserves
// history: revoke the old row, insert a new ACTIVE row with rotatedFromId
// pointing at the previous one. A partial unique index on
// (participantId) WHERE status = 'ACTIVE' guarantees ONE active QR per
// participant. Prisma's DSL cannot express it and `db push` does not manage
// it: it lives in prisma/sql/2026-badge-persistent-qr.sql, which MUST be
// applied on every environment after `db push` (verify with
// `npm run test:badge-schema`). The service layer also enforces
// single-active under a participant row lock.
//
// The QR token is HMAC-derived (see `sequence` below) so the current QR can
// be re-displayed; the raw token is still never stored — only its sha256.
model BadgeCredential {
  id            String      @id @default(cuid())
  participantId String
  tokenHash     String      @unique
  status        BadgeStatus @default(ACTIVE)
  issuedAt      DateTime    @default(now())
  expiresAt     DateTime?
  revokedAt     DateTime?
  revokedReason String?
  revokedById   String?
  rotatedFromId String?

  // Persistent-QR scheme. `sequence` is the per-participant version of the
  // credential (1, 2, 3 …). The QR token is derived server-side as
  // HMAC(BADGE_QR_TOKEN_SECRET, credential id + sequence), so the current QR
  // can be re-displayed without storing the raw token. NULL = legacy
  // hash-only credential issued before the persistent scheme: its raw token
  // is unrecoverable and it can only be replaced (never re-displayed).
  sequence    Int?
  // Admin who created this credential through an administrative
  // regeneration. NULL for system issuance (registration / cutover).
  createdById String?

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  // Self-relation chain: previous credential this one replaced, and any
  // credentials that were later rotated from this one.
  rotatedFrom BadgeCredential?  @relation("CredentialRotation", fields: [rotatedFromId], references: [id])
  rotatedTo   BadgeCredential[] @relation("CredentialRotation")

  checkIns CheckIn[]

  // Backstop: a participant can never hold two credentials with the same
  // sequence (NULLs are distinct in Postgres, so legacy rows are unaffected).
  @@unique([participantId, sequence])
  @@index([participantId])
  @@index([participantId, status])
  @@index([status])
}

// Per-participant, per-access-point permission. Existence with granted=true
// means the participant is authorized for that AccessPoint. Absence means
// NOT AUTHORIZED — the default. Business rule: room access is never
// auto-granted; an authorized admin must grant it explicitly OR the
// room-registration sync layer must materialize an entitlement from a
// confirmed RoomRegistration.
//
// The `source` field marks who owns this row's lifecycle:
//   ADMIN         Manual admin grant/revoke. Default. Includes every
//                 pre-existing row after migration.
//   REGISTRATION  Materialized by syncRoomAccessEntitlement.
// The sync service NEVER touches ADMIN rows — admin intent wins.
model ParticipantAccess {
  participantId String
  accessPointId String
  granted       Boolean           @default(true)
  grantedById   String?
  grantedAt     DateTime          @default(now())
  revokedAt     DateTime?
  revokedById   String?
  source        AccessGrantSource @default(ADMIN)

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  accessPoint AccessPoint @relation(fields: [accessPointId], references: [id], onDelete: Cascade)

  @@id([participantId, accessPointId])
  @@index([accessPointId])
  @@index([granted])
  @@index([source])
}

// --------------------------- ADMIN / OPERATIONS ---------------------------

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  SALES
  REGISTRATION_MANAGER
  CHECKIN_OPERATOR
  CONTENT_MANAGER
  SPONSOR_MANAGER
  FINANCE
  ANALYTICS
  VIEWER
}

enum AdminStatus {
  ACTIVE
  DISABLED
}

model AdminUser {
  id           String      @id @default(cuid())
  email        String      @unique
  name         String
  passwordHash String
  role         AdminRole   @default(VIEWER)
  status       AdminStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  sessions        AdminSession[]
  auditLogs       AuditLog[]
  checkIns        CheckIn[]
  speaker         Speaker?
  teamMemberships AccessPointTeamMember[]

  // Backup subsystem — see the BACKUP & RESTORE section at the end of
  // this file. All three relations are `onDelete: SetNull` so purging an
  // admin never drops backup audit history.
  backupsCreated  Backup[]           @relation("BackupCreatedBy")
  backupsVerified Backup[]           @relation("BackupVerifiedBy")
  restores        RestoreOperation[]

  @@index([role])
  @@index([status])
}

// Admin session record. The raw cookie token is generated at login and
// stored ONLY in the client's HTTP-only cookie; the database keeps only
// its sha256 hash (Phase 15). A DB dump cannot be directly replayed as
// admin cookies — an attacker would need to pre-image the sha256 first,
// which is infeasible against a 256-bit random token.
//
// SECURITY: never persist the raw token here. Every read/write path
// (lib/admin/auth.ts, adminLogout, speakerLogout, dev-only smoke) hashes
// the cookie value before it reaches Prisma.
model AdminSession {
  id        String    @id @default(cuid())
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id        String     @id @default(cuid())
  userId    String?
  user      AdminUser? @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String // "registrant.update", "checkin.validate", …
  entity    String? // "Participant"
  entityId  String?
  meta      Json?
  createdAt DateTime   @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([entity, entityId])
}

enum CheckInResult {
  VALID
  ALREADY_CHECKED_IN
  WRONG_GATE
  WRONG_TIME
  CANCELLED
  UNKNOWN
}

model CheckIn {
  id            String        @id @default(cuid())
  participantId String?
  participant   Participant?  @relation(fields: [participantId], references: [id], onDelete: SetNull)
  operatorId    String?
  operator      AdminUser?    @relation(fields: [operatorId], references: [id], onDelete: SetNull)
  ticketCode    String
  gate          String
  result        CheckInResult
  reason        String?
  scannedAt     DateTime      @default(now())

  // New: link to the AccessPoint the scanner is bound to. Nullable so legacy
  // rows (pre-migration) remain valid, and so the existing manual-code flow
  // that has no AccessPoint context continues to work. SetNull on delete
  // preserves the historical scan record if an AccessPoint is retired.
  accessPointId String?
  accessPoint   AccessPoint? @relation(fields: [accessPointId], references: [id], onDelete: SetNull)

  // New: which BadgeCredential presented the QR. Nullable for the manual code
  // path. SetNull preserves scan history if a credential row is deleted (in
  // practice we only revoke, we do not delete — this is defensive).
  credentialId String?
  credential   BadgeCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)

  @@index([participantId])
  @@index([scannedAt])
  @@index([result])
  @@index([accessPointId])
  @@index([accessPointId, scannedAt])
  @@index([credentialId])
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED
}

model EmailMessage {
  id            String      @id @default(cuid())
  participantId String?
  sentByUserId  String?
  toEmail       String
  toName        String?
  subject       String
  body          String      @db.Text
  html          String?     @db.Text
  templateKey   String?
  status        EmailStatus @default(QUEUED)
  errorMessage  String?
  createdAt     DateTime    @default(now())
  sentAt        DateTime?

  // ─── Delivery orchestration (Email Infrastructure Phase) ─────────────
  // idempotencyKey — deterministic key for callers to prevent duplicates
  //   (e.g. `verify:<userId>:<tokenHash>`). Nullable so admin composer
  //   emails keep their existing behaviour.
  // attemptCount / maxAttempts / nextAttemptAt — worker backoff state.
  // lastError — cleaner than errorMessage for the retry loop; sticky.
  // locale — reserved for future i18n; defaults to "fr".
  // provider / providerMsgId — audit trail for the transport (e.g. SMTP
  //   Message-ID returned by nodemailer).
  idempotencyKey String?   @unique
  attemptCount   Int       @default(0)
  maxAttempts    Int       @default(5)
  nextAttemptAt  DateTime?
  lastError      String?
  locale         String    @default("fr")
  provider       String?
  providerMsgId  String?

  @@index([participantId])
  @@index([createdAt])
  @@index([status])
  @@index([status, nextAttemptAt])
}

// Admin-authored email templates. A DB row with `isActive=true` overrides
// the same-key entry in the code catalog (`lib/admin/email-templates.ts`)
// at send time — see `lib/email/queue.ts::queueTemplatedEmail` and
// `lib/email/templates/service.ts::resolveTemplate`. Deactivating a row
// silently falls back to the code catalog, so the application never
// sends an empty email because an admin messed up.
//
// SECURITY: `htmlBody` is sanitized both on-write (in the admin action)
// and on-render (in `db-render.ts`). See the security-reviewer note in
// `service.ts`.
model EmailTemplate {
  id          String   @id @default(cuid())
  // Stable identifier the caller uses to look up the template
  // (`templateKey` on `queueTemplatedEmail`). Must match a code-catalog
  // key when overriding a system template, or be a fresh string for a
  // custom template.
  key         String   @unique
  name        String
  description String?
  // Free-form category ("auth", "registration", "room", …). Used for
  // grouping in the admin list; the send-time resolver never reads it.
  category    String
  subject     String
  preheader   String?
  htmlBody    String   @db.Text
  textBody    String   @db.Text
  useHeader   Boolean  @default(true)
  useFooter   Boolean  @default(true)
  // System-flagged rows are protected from deletion — deactivating them
  // is the safe operational off-switch. A DB row that overrides a
  // code-catalog template inherits this flag on create.
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(false)
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  versions EmailTemplateVersion[]

  @@index([category])
  @@index([isActive])
}

// Append-only snapshot of the PREVIOUS content of an `EmailTemplate` row
// captured on every update via `updateTemplateAndVersion` — powers the
// "restore version" flow in the admin editor.
model EmailTemplateVersion {
  id         String        @id @default(cuid())
  templateId String
  template   EmailTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version    Int
  subject    String
  preheader  String?
  htmlBody   String        @db.Text
  textBody   String        @db.Text
  createdBy  String?
  createdAt  DateTime      @default(now())

  @@unique([templateId, version])
  @@index([templateId])
}

model RolePermissionOverride {
  id         String    @id @default(cuid())
  role       AdminRole
  permission String
  granted    Boolean
  updatedAt  DateTime  @updatedAt
  updatedBy  String?

  @@unique([role, permission])
  @@index([role])
}

// --------------------------- ROOM REGISTRATION / ENTITLEMENT ---------------------------
//
// FREE per-room entitlement layer sitting between AccessPoint (physical
// space) and ParticipantAccess (fast scanner-facing authorization).
//
//   AccessPoint
//         │
//         ▼
//   RoomRegistration (participant × room; FREE_CONFIRMED | CANCELLED)
//         │
//         ▼   via syncRoomAccessEntitlement (canonical service, transactional, idempotent)
//         │
//   ParticipantAccess (source=REGISTRATION when materialized from here;
//                       ADMIN rows remain untouched by the sync service)
//         │
//         ▼
//   Room QR / text validator (reads granted boolean only)
//         │
//         ▼
//   CheckIn (physical entry)
//
// DB-level invariant: `@@unique([participantId, accessPointId])` — a
// participant cannot hold two rows for the same room. Re-registering
// after CANCELLED re-uses the row.
model RoomRegistration {
  id            String                 @id @default(cuid())
  participantId String
  accessPointId String
  status        RoomRegistrationStatus

  registeredAt DateTime  @default(now())
  cancelledAt  DateTime?
  updatedAt    DateTime  @updatedAt

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  accessPoint AccessPoint @relation(fields: [accessPointId], references: [id], onDelete: Cascade)

  @@unique([participantId, accessPointId])
  @@index([accessPointId, status])
  @@index([participantId])
  @@index([status])
}

// --------------------------- BACKUP & RESTORE ---------------------------
//
// Encrypted, authenticated, integrity-verified full database backups.
//
// SECURITY NOTES:
//   * The backup ciphertext lives on disk at BACKUP_STORAGE_DIR (never
//     committed, never inside the app tree). Only sha256(ciphertext) and
//     metadata are persisted here.
//   * The encryption key (BACKUP_ENCRYPTION_KEY) is loaded from env only;
//     the DB never sees it. Rows in this table are safe to leak — they
//     do NOT allow decryption of the backup file.
//   * Restore is a destructive administrative operation. Every path that
//     mutates a Backup or RestoreOperation row MUST call
//     requirePermission("backup.<verb>") first (see lib/admin/rbac.ts).
//   * A Backup row can only ever be marked COMPLETED after the write
//     succeeded AND the on-disk file's sha256 matches contentSha256 AND
//     the GCM tag verified. Any earlier state is treated as suspect.

enum BackupStatus {
  PENDING // row created, staging file being written
  RUNNING // dump in progress
  COMPLETED // dump finished, integrity hash recorded, promoted from staging
  VERIFIED // most recent explicit verification succeeded (superset of COMPLETED)
  FAILED // create OR verify failed — row kept for audit
  DELETED // retention cleanup removed the on-disk file (row kept for audit)
  MISSING // an integrity sweep observed the file to be absent
}

enum BackupKind {
  MANUAL // admin clicked "create backup now"
  SCHEDULED // scheduler tick triggered it
  SAFETY // auto-taken immediately before a restore operation
}

enum RestoreStatus {
  INITIATED // user requested; preflight not started
  PREFLIGHT // verifying selected backup + schema compat
  RUNNING // destructive apply in progress inside a transaction
  COMPLETED // finished, all sessions invalidated
  FAILED // aborted; DB rolled back or safety backup used
  ROLLED_BACK // safety backup restored after a failed apply
}

// A Backup row is the durable metadata of one attempt at creating an
// encrypted database dump. It never contains secrets or plaintext data.
// The row's status is the authoritative signal — never trust the mere
// presence of a file on disk.
model Backup {
  id                String       @id @default(cuid())
  status            BackupStatus @default(PENDING)
  kind              BackupKind
  startedAt         DateTime     @default(now())
  completedAt       DateTime?
  sizeBytes         BigInt?
  // Server-derived relative filename (`<id>.bin`) under BACKUP_STORAGE_DIR.
  // NEVER accepts client input. NEVER contains an absolute path or a slash.
  // Cap at 64 chars — cuid is 25, extension is 4, gives generous headroom
  // while forbidding a bug that ever tries to persist an attacker-influenced
  // path.
  fileName          String?      @db.VarChar(64)
  // sha256 of the on-disk ciphertext file. Verified independently of the
  // GCM tag so a truncated file is detected before decryption is attempted.
  contentSha256     String?
  // sha256 of the manifest JSON text as written (fields + HMAC included).
  manifestSha256    String?
  // sha256 of prisma/schema.prisma at backup time — enables compatibility
  // check at restore time.
  schemaSha256      String
  appVersion        String
  formatVersion     String       @default("1")
  encryptionVersion String       @default("v1")
  // Per-model row counts captured at dump time; used to detect a
  // corrupted or partial file during verification.
  rowCounts         Json?
  errorMessage      String?
  // Admin who triggered a manual backup. NULL for SCHEDULED and SAFETY.
  // SetNull on delete: preserves backup audit history if the admin is
  // ever removed.
  createdById       String?
  createdBy         AdminUser?   @relation("BackupCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  verifiedAt        DateTime?
  verifiedById      String?
  verifiedBy        AdminUser?   @relation("BackupVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  // Result of the most recent verify call: OK | MISSING | SIZE_MISMATCH |
  // SHA_MISMATCH | TAMPERED | MANIFEST_HMAC_FAIL | ROW_COUNT_MISMATCH |
  // SCHEMA_MISMATCH — kept as a free-form string so future verifier
  // versions can extend the vocabulary without a schema migration.
  verifyResult      String?

  // Restore operations that used THIS backup as the source-of-truth being
  // restored. Named relation so it is distinct from `safetyBackupFor` below.
  restores        RestoreOperation[] @relation("RestoreSource")
  // Restore operations that took THIS backup as a pre-restore safety
  // snapshot. Nullable FK on the RestoreOperation side (SetNull) so a
  // retention prune of the safety backup preserves the restore audit row
  // while surfacing "safety snapshot is no longer available" via NULL.
  safetyBackupFor RestoreOperation[] @relation("RestoreSafety")

  // ─── Google Drive off-site replication (Backup Drive Replication) ─────
  // Off-site replication rows for this backup. One-to-many so the schema
  // can later host additional destinations without another migration;
  // v1 has exactly one destination (GOOGLE_DRIVE) and enforces
  // one-row-per-(backup, destination) via a unique constraint on
  // BackupReplication. A local Backup lifecycle is INDEPENDENT of any
  // replication row — nothing in lib/backup/replication ever writes to
  // Backup.status. See docs/BACKUP_GOOGLE_DRIVE_IMPLEMENTATION_PLAN.md.
  replications BackupReplication[]

  @@index([status])
  @@index([startedAt])
  @@index([kind])
  @@index([status, startedAt])
}

// Every restore attempt — successful or not — leaves a permanent audit
// row. safetyBackupId points at the Backup row of the snapshot taken
// immediately before the destructive apply (see lib/backup/restore.ts).
model RestoreOperation {
  id             String        @id @default(cuid())
  // Explicit `Restrict`: a Backup that has restore history CANNOT be
  // deleted (protects incident-review integrity). Retention prune must
  // check for referencing RestoreOperation rows before deleting the
  // Backup row — see lib/backup/retention.ts.
  backupId       String
  backup         Backup        @relation("RestoreSource", fields: [backupId], references: [id], onDelete: Restrict)
  status         RestoreStatus @default(INITIATED)
  startedAt      DateTime      @default(now())
  completedAt    DateTime?
  // The admin who initiated the restore. Restore requires
  // `backup.restore` + a password re-auth (see lib/backup/restore.ts);
  // the row therefore always has a real actor. Explicit `Restrict` so
  // the row is preserved even if the admin account is later purged —
  // critical for post-incident review.
  initiatedById  String
  initiatedBy    AdminUser     @relation(fields: [initiatedById], references: [id], onDelete: Restrict)
  // If a pre-restore safety snapshot succeeded, this points at it.
  // SetNull on delete: a retention prune of the safety backup nulls the
  // pointer but preserves the RestoreOperation row (audit trail intact,
  // "safety snapshot no longer available" visible via NULL).
  safetyBackupId String?
  safetyBackup   Backup?       @relation("RestoreSafety", fields: [safetyBackupId], references: [id], onDelete: SetNull)
  errorMessage   String?
  meta           Json?

  @@index([backupId])
  @@index([startedAt])
  @@index([initiatedById])
  @@index([safetyBackupId])
}

// Single-row configuration table (id is a hardcoded literal) governing
// automated backup behaviour. Disabled by default — the operator must
// explicitly opt-in via the settings UI or a seed script.
model BackupSchedule {
  id               String   @id @default("singleton")
  enabled          Boolean  @default(false)
  // 1..168 (1h..1 week). Enforced by the settings server action, not the DB.
  frequencyHours   Int      @default(24)
  // Keep the N most recent COMPLETED / VERIFIED backups. Enforced with a
  // floor of 1 in the retention code — regardless of misconfiguration,
  // retention MUST NEVER leave zero valid backups.
  retentionCount   Int      @default(14)
  // Maximum age (days) of a retained backup. Independent of retentionCount:
  // a backup older than this is prunable EVEN IF the count is under the
  // ceiling — UNLESS its deletion would drop us below the retention floor.
  // 0 disables the age-based rule. Enforced in lib/backup/retention.ts.
  retentionAgeDays Int      @default(90)
  updatedAt        DateTime @updatedAt
  updatedById      String?

  // ─── Scheduler state (Phase 8) ────────────────────────────────────────
  // Persisted so a duplicate cron POST is idempotent: the tick service
  // compares (lastRunAt + frequencyHours) against `now()` under a
  // Postgres advisory lock; a same-second retry sees `lastRunAt=now` and
  // treats itself as "not due", never creating a duplicate backup.
  // `lastRunOutcome` distinguishes SUCCESS / FAILURE / SKIPPED so the
  // dashboard can surface schedule health without reading the audit log.
  lastRunAt       DateTime? // last time the tick actually attempted a backup
  // "OK" | "RUNNING" | "FAILED_DUMP" | "FAILED_VERIFY" | "FAILED_INTERNAL_STUCK"
  //   | "SKIPPED_LOCKED" | "SKIPPED_NOT_DUE" | "SKIPPED_DISABLED" | "SKIPPED_ACTIVE" | "INTERNAL"
  // Kept as a free-form string (not an enum) so future outcomes can be
  // added without a migration. See lib/backup/scheduler.ts::SchedulerOutcome.
  lastRunOutcome  String?
  lastRunBackupId String? // Backup row created by the last run (SUCCESS or FAILURE)
  lastRunError    String? // sanitized failure code, never a raw exception
  // Bounded catch-up: after an outage, at most ONE backup is created per
  // tick — never a burst of N=missed-intervals. Documented in
  // BACKUP_RESTORE_IMPLEMENTATION_PLAN.md.
}

// ─────────────────────────────────────────────────────────────────────────
// GOOGLE DRIVE OFF-SITE REPLICATION (Layer A of the Drive replication plan)
// ─────────────────────────────────────────────────────────────────────────
//
// Purpose: every locally VERIFIED Backup is replicated, asynchronously and
// idempotently, to a dedicated application-managed folder in the operator's
// Google Drive. Only the already-encrypted `.bin` and signed
// `.manifest.json` artefacts are uploaded — never plaintext, never keys.
//
// Invariants enforced across the code paths that USE this schema (not by
// the schema itself; documented here for the reader):
//   • Nothing in lib/backup/replication/** ever writes to Backup.status.
//     A Google Drive outage cannot regress a VERIFIED local backup.
//   • Idempotency is anchored on `@@unique([backupId, destination])`:
//     exactly one replication row per (backup, destination). Retries
//     mutate this row rather than creating siblings.
//   • The `errorMessage` column is sanitized on every write — no OAuth
//     tokens, no session URIs, no request headers. Capped at 512 chars.
//   • `attestedContentSha256` is populated ONLY by a full-SHA256 verify
//     (download + hash). METADATA_ONLY verify leaves it null. Do not
//     misread this field.
// ─────────────────────────────────────────────────────────────────────────

// Off-site destination. Enum (rather than free-form string) so a typo in
// a lib/backup/replication file becomes a compile error. v1 has exactly
// one destination — future destinations (R2/S3) can be added without a
// column rename.
enum BackupReplicationDestination {
  GOOGLE_DRIVE
}

// State-machine states. Documented transitions live in
// docs/BACKUP_GOOGLE_DRIVE_IMPLEMENTATION_PLAN.md § K.
enum BackupReplicationStatus {
  PENDING // enqueued; worker has not touched it yet
  UPLOADING // worker owns it; a resumable-upload session may exist
  VERIFYING // upload done; running metadata / SHA-256 verify
  COMPLETED // metadata-verified remote object present
  RETRYABLE_FAILURE // transient failure; nextRetryAt set
  FAILED // permanent failure; requires manual admin retry
}

// Classified error code. Never accepts a raw Google error string. See
// docs/BACKUP_GOOGLE_DRIVE_IMPLEMENTATION_PLAN.md § I for the full
// classifier truth table.
enum BackupReplicationErrorCode {
  NONE
  AUTHENTICATION_ERROR // Drive 401 or transient token-refresh failure
  REVOKED_AUTHORIZATION // OAuth `invalid_grant` — refresh token revoked/invalid
  AUTHORIZATION_ERROR // 403 insufficient permission on the folder
  DESTINATION_NOT_FOUND // folder ID from config no longer exists in Drive
  QUOTA_EXCEEDED // Drive `storageQuotaExceeded`
  RATE_LIMITED // 429 or 403 `userRateLimitExceeded`
  NETWORK_ERROR // ECONNRESET / TLS / socket
  TIMEOUT // deadline exceeded
  SERVER_ERROR // 500 / 502 / 503 / 504
  UPLOAD_SESSION_EXPIRED // resumable session URI no longer valid
  REMOTE_VERIFICATION_FAILED // metadata comparison mismatch (name/parent/appProperties)
  REMOTE_SIZE_MISMATCH // Drive-reported size ≠ expected
  REMOTE_CHECKSUM_MISMATCH // Drive MD5 ≠ our MD5, or our SHA-256 ≠ Backup.contentSha256
  LOCAL_SOURCE_MISSING // published/<id>.bin gone before we could upload
  LOCAL_SOURCE_CORRUPTED // preflight SHA-256 of local file ≠ Backup.contentSha256
  CONFIGURATION_ERROR // env misconfigured / folder ID unset / duplicate folder
  UNKNOWN
  // Layer J (§O.2): Drive returned 404 for a remote object we had
  // previously recorded. Applied by `reconcileReplicationRemote`
  // without touching Backup.status or BackupReplication.status —
  // the row stays COMPLETED to preserve the historical fact that
  // the upload+metadata verify DID succeed.
  REMOTE_MISSING
}

// Verification level attested by `attestedContentSha256` + `lastVerifyLevel`.
// See § J for the honesty-gate discussion — do NOT conflate METADATA_ONLY
// (Google's MD5) with FULL_SHA256 (our own re-download + SHA-256).
enum BackupReplicationVerifyLevel {
  NONE // never attempted
  METADATA_ONLY // Drive-reported size + md5Checksum + appProperties match
  FULL_SHA256 // downloaded + application SHA-256 recomputed and matched
}

// One row per (Backup, destination). Insert happens when Backup transitions
// to VERIFIED (scheduler post-verify enqueue; or self-heal query at the
// top of every worker tick). All Drive network I/O happens OUTSIDE any
// database transaction — see Layer L.
model BackupReplication {
  id String @id @default(cuid())

  // Restrict on delete for the same reason RestoreOperation uses Restrict
  // on backupId: preserve audit history. Backup rows are soft-deleted
  // (Backup.status = DELETED) rather than physically removed, so
  // `onDelete: Restrict` is not an operational hazard.
  backupId String
  backup   Backup @relation(fields: [backupId], references: [id], onDelete: Restrict)

  destination BackupReplicationDestination
  status      BackupReplicationStatus      @default(PENDING)

  // ── Remote identity (null until the first successful upload) ──
  remoteBinFileId      String? @db.VarChar(128)
  remoteManifestFileId String? @db.VarChar(128)
  remoteFolderId       String? @db.VarChar(128)
  remoteBinSize        BigInt?
  remoteManifestSize   BigInt?
  // Google's own MD5 of the .bin — meaningful only for the METADATA_ONLY
  // level. NOT a SHA-256 attestation.
  remoteBinMd5         String? @db.VarChar(64)
  remoteManifestMd5    String? @db.VarChar(64)

  // ── SHA-256 attestation (only present after FULL_SHA256 verify) ──
  attestedContentSha256 String?                      @db.VarChar(64)
  lastVerifyLevel       BackupReplicationVerifyLevel @default(NONE)
  lastVerifiedAt        DateTime?

  // ── Resumable-upload session state (crash-recovery anchor) ──
  // sessionUri is Google's opaque URL — treat as a session token. Bounded
  // so a malicious/mistaken write cannot flood the column.
  uploadSessionUri       String?   @db.VarChar(2048)
  uploadSessionExpiresAt DateTime? // ≈ +7 days from creation
  uploadBytesSent        BigInt? // last confirmed byte count

  uploadStartedAt   DateTime?
  uploadCompletedAt DateTime?
  lastAttemptAt     DateTime?
  attemptCount      Int       @default(0)
  nextRetryAt       DateTime? // null when not scheduled

  errorCode    BackupReplicationErrorCode @default(NONE)
  // Sanitized, ≤512 chars. Never a URL, never a token, never a raw
  // Google response body. Rendered as-is in the admin UI.
  errorMessage String?                    @db.VarChar(512)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([backupId, destination])
  @@index([status, nextRetryAt])
  @@index([destination, status])
}

// Singleton config row for the Google Drive backup destination. The
// application creates its own dedicated folder in the user's Drive on
// first bootstrap (Layer B script) and persists its Drive folderId
// here. The folder is re-discoverable via a marker stored in the
// folder's Drive `appProperties` — the app never trusts folder names
// alone for identity.
model BackupReplicationConfig {
  id String @id @default("google_drive")

  // Drive folder ID (opaque; not a secret — appears in Drive URLs). Null
  // until the bootstrap script has successfully created (or discovered)
  // the folder in the authorized user's Drive.
  folderId String? @db.VarChar(128)

  // Human-readable folder name used when the bootstrap script creates the
  // folder. Not used for identity — only for the initial `files.create`
  // call. Renaming this after bootstrap does NOT move the actual folder.
  folderName String @default("BIS 2027 — Encrypted Backups (managed by application)")

  // Value written to the folder's Drive `appProperties.marker` on
  // creation. Used by the worker to re-discover the folder if `folderId`
  // is ever lost (e.g., DB restore from an earlier point in time). The
  // marker is stable across app versions; do NOT rename without an
  // explicit migration plan.
  folderMarker String @default("bis2027-backup-folder-v1")

  bootstrappedAt   DateTime?
  lastReconciledAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}
