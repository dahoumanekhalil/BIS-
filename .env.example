# -----------------------------------------------------------------------------
# BIS 2026 — environment template
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values. Never commit real secrets.
# -----------------------------------------------------------------------------

DATABASE_URL="postgresql://admin:secret123@localhost:5432/getplus_summit_2026?schema=public"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# =============================================================================
# ADMIN ACCOUNTS (dev demo — do NOT use in production)
# =============================================================================
# Admin credentials are seeded by `npm run db:seed`. Passwords are NOT stored
# as env vars — they are hardcoded in prisma/seed.ts behind a production guard.
#
# Dev demo: every account uses the shared password `admin123`.
#
# Role         | Email                       | Password
# -------------|-----------------------------|-----------
# SUPER_ADMIN  | admin@bis-algeria.dz        | admin123
# ADMIN        | admin2@bis-algeria.dz       | admin123
# SALES        | sales@bis-algeria.dz        | admin123
# CHECKIN_OP   | checkin@bis-algeria.dz      | admin123
# =============================================================================

# ALLOW_DESTRUCTIVE_SEED="false"

# =============================================================================
# EMAIL / SMTP INFRASTRUCTURE
# =============================================================================
# Two-layer configuration:
#   • Runtime SMTP settings (host, credentials, from-address) are stored in
#     the DB (SiteContent "email.smtp") and edited from /admin/settings/email.
#     Passwords are encrypted at rest with AES-256-GCM.
#   • The ENV variables below take precedence over any DB values when set,
#     so a deployment can keep secrets in a real secrets manager and let
#     admins only tweak friendly fields.
#
# REQUIRED for a working deployment:
#
#   EMAIL_SECRET_ENCRYPTION_KEY  — 32-byte key, base64url or hex encoded.
#                                  Used to encrypt the SMTP password at rest.
#                                  Generate one with:
#     node -e "process.stdout.write(require('crypto').randomBytes(32).toString('base64url'))"
#
#   INTERNAL_EMAIL_TICK_SECRET   — shared secret sent in the
#                                  `x-internal-secret` header by whichever
#                                  scheduler triggers /api/internal/email/tick.
#                                  Must be at least 24 characters. Generate:
#     node -e "process.stdout.write(require('crypto').randomBytes(48).toString('base64url'))"
#
# EMAIL_SECRET_ENCRYPTION_KEY=""
# INTERNAL_EMAIL_TICK_SECRET=""

# Optional ENV overrides. When set, these win over the DB values. Use them to
# keep production credentials out of the database entirely.
#
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_ENCRYPTION="starttls"        # none | starttls | ssl
# SMTP_AUTH_ENABLED="true"
# SMTP_USERNAME=""
# SMTP_PASSWORD=""                  # if set, DB password is ignored
# SMTP_FROM_EMAIL="no-reply@bis-algeria.dz"
# SMTP_FROM_NAME="BIS 2026"
# SMTP_REPLY_TO=""
# SMTP_CONNECTION_TIMEOUT_MS="15000"
# SMTP_AUTH_TIMEOUT_MS="15000"
# EMAIL_MAX_ATTEMPTS="5"
# EMAIL_CONTACT_RECIPIENT=""        # default recipient for the contact form
#
# Delivery mode. Use "log-only" on developer machines so no real email leaves
# the box. Use "off" to hard-disable sending. "live" performs real SMTP sends.
# EMAIL_MODE="log-only"
#
# In non-production ONLY: comma-separated allowlist of recipient email
# domains that may receive a real send. Anything else is refused with an
# "allowlist" reason so a developer running with `EMAIL_MODE=live` cannot
# accidentally spam real attendees.
# EMAIL_ALLOWLIST="example.com,ops.internal"
